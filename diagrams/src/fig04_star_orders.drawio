=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.3745;entryX=0;entryY=0.4103;exitPerimeter=0;entryPerimeter=0;rounded=0;" edge="1" parent="1" source="v1" target="v25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="898.5714285714286" y="286.0"/><mxPoint x="898.5714285714286" y="450.0"/></Array></mxGeometry></mxCell><mxCell id="e39" value="" style="html=1;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.3404;entryX=0;entryY=0.4103;exitPerimeter=0;entryPerimeter=0;rounded=0;" edge="1" parent="1" source="v1" target="v23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="934.2857142857142" y="270.0"/><mxPoint x="934.2857142857142" y="348.0"/></Array></mxGeometry></mxCell><mxCell id="v40" value="Shaded = fact table. Underlined = primary key; in the fact table it is made of all the foreign keys (FK). AK = alternate key, the key of the source system. Each arrow goes from a foreign key to the primary key it references; dim_zone is referenced twice (pickup and drop-off).&lt;br&gt;Dimension tables are not normalised (star schema); client, driver and zone keep branch_key in their alternate key because ids repeat between branches." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="890" width="1160" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>