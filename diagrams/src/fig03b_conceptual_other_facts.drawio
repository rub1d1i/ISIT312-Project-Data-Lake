lor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;labelBackgroundColor=#ffffff;startArrow=ERmany;startFill=0;startSize=10;endArrow=none;exitX=0;exitY=0.5417;entryX=1;entryY=0.3000;exitPerimeter=0;entryPerimeter=0;rounded=0;" edge="1" parent="1" source="v21" target="v3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="763.3333333333334" y="95.0"/><mxPoint x="763.3333333333334" y="253.8"/></Array></mxGeometry></mxCell><mxCell id="e47" value="" style="html=1;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;labelBackgroundColor=#ffffff;startArrow=ERmany;startFill=0;startSize=10;endArrow=none;exitX=0;exitY=0.3125;entryX=1;entryY=0.3000;exitPerimeter=0;entryPerimeter=0;rounded=0;" edge="1" parent="1" source="v21" target="v1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="741.6666666666666" y="67.5"/><mxPoint x="741.6666666666666" y="78.6"/></Array></mxGeometry></mxCell><mxCell id="e48" value="" style="html=1;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;labelBackgroundColor=#ffffff;startArrow=ERmany;startFill=0;startSize=10;endArrow=oval;endFill=0;endSize=9;exitX=1;exitY=0.4500;entryX=0;entryY=0.5;" edge="1" parent="1" source="v21" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="" style="html=1;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;labelBackgroundColor=#ffffff;startArrow=ERmany;startFill=0;startSize=10;endArrow=none;exitX=1;exitY=0.1750;entryX=0;entryY=0.4;" edge="1" parent="1" source="v25" target="v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v50" value="Same notation as the Orders schema. Date, Hour, Branch, Driver and Zone are the levels shared with the Orders fact; their hierarchies (Calendar, DayParts, Geography, Employment, Vehicles, ZoneTypes) are drawn there and not repeated.&lt;br&gt;A call that no operator handled (an automatic informer call) has no Operator; a ledger item is identified by account and item name together. Call type, direction and outcome of a call are kept in the fact table (constellation schema)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="10" y="600" width="1280" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>