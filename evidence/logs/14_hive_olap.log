0: jdbc:hive2://localhost:10000> SELECT b.city_label, t.day_part, SUM(f.order_count) AS orders,
. . . . . . . . . . . . . . . .>        ROUND(AVG(f.arrival_minutes), 1) AS avg_arrival_min
