#!/usr/bin/env python3
# Hadoop Streaming word count - mapper: one "word<TAB>1" line per word.
import sys

for line in sys.stdin:
    for word in line.strip().lower().split():
        print(f"{word}\t1")

$ cat /home/bigdata/project/env/smoke/scripts/wc_reducer.py
#!/usr/bin/env python3
# Hadoop Streaming word count - reducer: input arrives sorted by word.
import sys

current, total = None, 0
for line in sys.stdin:
    word, _, count = line.rstrip("\n").partition("\t")
    if word != current:
        if current is not None:
            print(f"{current}\t{total}")
        current, total = word, 0
    total += int(count)
if current is not None:
    print(f"{current}\t{total}")

